{
  "name": "sadhana",
  "version": "2.0.0",
  "description": "Sādhana — a local-first saṅkalpa (vow) tracker with a real, on-device pañcāṅga.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "sadhana",
    "vow-tracker",
    "panchang",
    "tithi",
    "local-first",
    "offline",
    "react",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  }
}
